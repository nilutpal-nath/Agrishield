rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny-All Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Validation
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['id', 'email', 'createdAt']) &&
        data.keys().hasOnly(['id', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        data.id == userId &&
        data.email is string && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('role' in data) || (data.role is string && data.role.size() <= 64)) &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Scan Record Validation
    function isValidScanRecord(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'date', 'disease', 'location', 'status', 'confidence']) &&
        data.keys().hasOnly(['id', 'userId', 'date', 'disease', 'pathogen', 'crop', 'location', 'status', 'confidence', 'imageCount', 'lossMitigated', 'notes', 'daysAgo', 'createdAt', 'updatedAt', 'recoveryImages']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId == userId &&
        data.date is string && data.date.size() <= 64 &&
        data.disease is string && data.disease.size() <= 128 &&
        (!('pathogen' in data) || (data.pathogen is string && data.pathogen.size() <= 128)) &&
        (!('crop' in data) || (data.crop is string && data.crop.size() <= 128)) &&
        data.location is string && data.location.size() <= 256 &&
        data.status in ['Follow-up Required', 'Active Treatment', 'Resolved', 'Monitoring'] &&
        data.confidence is number && data.confidence >= 0 && data.confidence <= 100 &&
        (!('imageCount' in data) || (data.imageCount is number && data.imageCount >= 0)) &&
        (!('lossMitigated' in data) || (data.lossMitigated is string && data.lossMitigated.size() <= 64)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 2048)) &&
        (!('daysAgo' in data) || (data.daysAgo is number && data.daysAgo >= 0));
    }

    // Match User Root Document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId) &&
                    incoming().id == existing().id && incoming().createdAt == existing().createdAt;
      allow delete: if false;

      // Match Scoped Scan Records Subcollection
      match /records/{recordId} {
        allow get: if isOwner(userId) && isValidId(recordId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(recordId) && isValidScanRecord(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(recordId) && isValidScanRecord(incoming(), userId) &&
                      incoming().id == existing().id && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(recordId);
      }
    }
  }
}
